# ==============================================================================
# Pluvira Environment Variables Template
# Copy this file to '.env' in the project root and modify as needed.
# ==============================================================================

# Directories & Storage (Can be relative to project root or absolute paths)
PLUVIRA_CONFIG_DIR=./config
PLUVIRA_DATA_DIR=./data
PLUVIRA_TEMP_DIR=/dev/shm/pluvira

# Server & Network
PLUVIRA_API_HOST=0.0.0.0
PLUVIRA_API_PORT=8585
# Storage secret used for local data encryption (specify a custom 32-character secret; do not leave default)
PLUVIRA_STORAGE_SECRET=custom_random_storage_secret_key_32_chars

# Cloud SaaS Infrastructure (Default: https://pluvira.com)
# Derives: /portal (Customer Portal), /auth (Logto IAM), /docs (Documentation)
# PLUVIRA_CLOUD_BASE_URL=https://pluvira.com

# Caching (memory | sqlite | disabled)
PLUVIRA_CACHE_DRIVER=memory
PLUVIRA_CACHE_TTL=3600

# Native Pro Engine
PLUVIRA_PRO_BINARY_PATH=/app/bin/pluvira-pro

